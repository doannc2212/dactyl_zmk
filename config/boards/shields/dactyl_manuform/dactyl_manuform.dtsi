#include <dt-bindings/zmk/matrix_transform.h>

/ {
    chosen {
        zmk,kscan = &kscan0;
        zmk,matrix_transform = &default_transform;
        zmk,physical-layout = &physical_layout0;
        zephyr,display = &oled;
        zmk,studio-unlock-on-start;
    };

    behaviors {
        studio_unlock: studio_unlock {
            compatible = "zmk,behavior-studio-unlock";
            #binding-cells = <0>;
        };
    };

    default_transform: keymap_transform_0 {
        compatible = "zmk,matrix-transform";
        columns = <12>;
        rows = <7>;
        map = <
RC(0,0) RC(0,1) RC(0,2) RC(0,3) RC(0,4) RC(0,5)                   RC(0,6) RC(0,7) RC(0,8) RC(0,9) RC(0,10) RC(0,11)
RC(1,0) RC(1,1) RC(1,2) RC(1,3) RC(1,4) RC(1,5)                   RC(1,6) RC(1,7) RC(1,8) RC(1,9) RC(1,10) RC(1,11)
RC(2,0) RC(2,1) RC(2,2) RC(2,3) RC(2,4) RC(2,5)                   RC(2,6) RC(2,7) RC(2,8) RC(2,9) RC(2,10) RC(2,11)
RC(3,0) RC(3,1) RC(3,2) RC(3,3) RC(3,4) RC(3,5)                   RC(3,6) RC(3,7) RC(3,8) RC(3,9) RC(3,10) RC(3,11)
                RC(4,2) RC(4,3)                                                   RC(4,8) RC(4,9)
                                RC(4,4) RC(4,5)                   RC(4,6) RC(4,7)
                                RC(5,4) RC(5,5)                   RC(5,6) RC(5,7)
                                RC(6,4) RC(6,5)                   RC(6,6) RC(6,7)
        >;
    };

    kscan0: kscan {
        compatible = "zmk,kscan-gpio-matrix";
        label = "KSCAN";

        wakeup-source;
        diode-direction = "col2row";
        row-gpios
            = <&pro_micro 2 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            , <&pro_micro 3 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            , <&pro_micro 4 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            , <&pro_micro 5 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            , <&pro_micro 6 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            , <&pro_micro 7 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            , <&pro_micro 8 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            ;

    };

    physical_layout0: physical_layout_0 {
        compatible = "zmk,physical-layout";
        display-name = "Default Layout";
        transform = <&default_transform>;
        kscan = <&kscan0>;
        keys = <
            <&key_physical_attrs 0 0 100 100> <&key_physical_attrs 100 0 100 100> <&key_physical_attrs 200 0 100 100> <&key_physical_attrs 300 0 100 100> <&key_physical_attrs 400 0 100 100> <&key_physical_attrs 500 0 100 100>
            <&key_physical_attrs 800 0 100 100> <&key_physical_attrs 900 0 100 100> <&key_physical_attrs 1000 0 100 100> <&key_physical_attrs 1100 0 100 100> <&key_physical_attrs 1200 0 100 100> <&key_physical_attrs 1300 0 100 100>
            <&key_physical_attrs 0 100 100 100> <&key_physical_attrs 100 100 100 100> <&key_physical_attrs 200 100 100 100> <&key_physical_attrs 300 100 100 100> <&key_physical_attrs 400 100 100 100> <&key_physical_attrs 500 100 100 100>
            <&key_physical_attrs 800 100 100 100> <&key_physical_attrs 900 100 100 100> <&key_physical_attrs 1000 100 100 100> <&key_physical_attrs 1100 100 100 100> <&key_physical_attrs 1200 100 100 100> <&key_physical_attrs 1300 100 100 100>
            <&key_physical_attrs 0 200 100 100> <&key_physical_attrs 100 200 100 100> <&key_physical_attrs 200 200 100 100> <&key_physical_attrs 300 200 100 100> <&key_physical_attrs 400 200 100 100> <&key_physical_attrs 500 200 100 100>
            <&key_physical_attrs 800 200 100 100> <&key_physical_attrs 900 200 100 100> <&key_physical_attrs 1000 200 100 100> <&key_physical_attrs 1100 200 100 100> <&key_physical_attrs 1200 200 100 100> <&key_physical_attrs 1300 200 100 100>
            <&key_physical_attrs 0 300 100 100> <&key_physical_attrs 100 300 100 100> <&key_physical_attrs 200 300 100 100> <&key_physical_attrs 300 300 100 100> <&key_physical_attrs 400 300 100 100> <&key_physical_attrs 500 300 100 100>
            <&key_physical_attrs 800 300 100 100> <&key_physical_attrs 900 300 100 100> <&key_physical_attrs 1000 300 100 100> <&key_physical_attrs 1100 300 100 100> <&key_physical_attrs 1200 300 100 100> <&key_physical_attrs 1300 300 100 100>
            <&key_physical_attrs 200 400 100 100> <&key_physical_attrs 300 400 100 100>
            <&key_physical_attrs 1000 400 100 100> <&key_physical_attrs 1100 400 100 100>
            <&key_physical_attrs 400 400 100 100> <&key_physical_attrs 500 400 100 100>
            <&key_physical_attrs 800 400 100 100> <&key_physical_attrs 900 400 100 100>
            <&key_physical_attrs 400 500 100 100> <&key_physical_attrs 500 500 100 100>
            <&key_physical_attrs 800 500 100 100> <&key_physical_attrs 900 500 100 100>
            <&key_physical_attrs 400 600 100 100> <&key_physical_attrs 500 600 100 100>
            <&key_physical_attrs 800 600 100 100> <&key_physical_attrs 900 600 100 100>
        >;
    };
};


&pro_micro_i2c {
    status = "okay";
    oled: sh1106@3c {
        compatible = "sinowealth,sh1106";
        reg = <0x3c>;
        width = <129>;
        height = <64>;
        segment-offset = <1>;
        page-offset = <0>;
        display-offset = <0>;
        multiplex-ratio = <63>;
        segment-remap;
        com-invdir;
        inversion-on;
        prechargep = <0x22>;
        };
}; 
